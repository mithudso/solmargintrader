{
  "name": "oraclebot",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-11",
  "account_id": "b41ba4dc457dce7653c93af955ecc462",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "services": [
    { "binding": "ENGINE_SERVICE", "service": "oraclebot-analysis-runtime" },
    { "binding": "USER_TRADE_EXECUTOR", "service": "oraclebot-customer-execution" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oraclebot-accounts",
      "database_id": "5526a15f-8063-4b5b-8a9d-b20babf0337d",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://oraclebot.io",
    "RELEASE": "website-0.4.0",
    "APP_VERSION": "0.4.0",
    "BILLING_LAUNCH_ENABLED": "false",
    "LIVE_EXECUTION_ENABLED": "false",
    "EXECUTOR_RECONCILIATION_ENABLED": "true",
    "EXECUTOR_AVAILABLE_VENUES": "[\"coinbase\"]"
  },
  "routes": [
    {
      "pattern": "oraclebot.io",
      "custom_domain": true
    },
    {
      "pattern": "www.oraclebot.io",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "0 3 * * *",
      "* * * * *"
    ]
  }
}
