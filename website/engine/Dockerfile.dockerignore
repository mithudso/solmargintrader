# Repository-root build context: admit only the three required Python projects.
**
!backtester/
!backtester/__init__.py
!backtester/pyproject.toml
!backtester/core/
!backtester/core/**
!backtester/strategy_cards/
!backtester/strategy_cards/**
!oracle/
!oracle/*.py
!oracle/pyproject.toml
!oracle/README.md
!website/
!website/engine/
!website/engine/**

# Re-apply exclusions after allow rules. None of these may enter the image.
**/.git
**/.git/**
**/.env*
**/.private
**/.private/**
**/node_modules
**/node_modules/**
**/__pycache__
**/__pycache__/**
**/build
**/build/**
**/dist
**/dist/**
**/*.egg-info
**/*.egg-info/**
**/tests
**/tests/**
**/test_*.py
**/data
**/data/**
**/results
**/results/**
**/inputs
**/inputs/**
**/*.sqlite*
**/*.db
**/*.key
**/*.pem
**/*.private
**/*.log
**/*.pyc
