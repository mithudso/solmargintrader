{
  "info": {
    "name": "Oraclebot public deployment acceptance",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://oraclebot.io"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('Trading remains disarmed',()=>pm.expect(pm.response.json().liveExecution).to.eql(false));"
            ]
          }
        }
      ]
    },
    {
      "name": "Configuration",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/config"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('Seven day trial',()=>pm.expect(pm.response.json().trialDays).to.eql(7));",
              "pm.test('Owner-defined plan policies',()=>pm.expect(pm.response.json().plans).to.deep.eql([{id:'starter',name:'Starter',monthlyUsd:9.99,botLimit:3,backtestsPerDay:10},{id:'advanced',name:'Advanced',monthlyUsd:29.99,botLimit:10,backtestsPerDay:null},{id:'unlimited',name:'Unlimited',monthlyUsd:49.99,botLimit:null,backtestsPerDay:null}]));",
              "pm.test('Public Checkout stays closed',()=>pm.expect(pm.response.json().billingConfigured).to.eql(false));"
            ]
          }
        }
      ]
    },
    {
      "name": "Anonymous account",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('No account leaks',()=>pm.expect(pm.response.json().user).to.eql(null));"
            ]
          }
        }
      ]
    },
    {
      "name": "Private bots denied",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/bots"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401',()=>pm.response.to.have.status(401));",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "MCP resource discovery",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/.well-known/oauth-protected-resource/mcp"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP200',()=>pm.response.to.have.status(200));",
              "pm.test('Exact resource',()=>pm.expect(pm.response.json().resource).to.eql(pm.variables.get('baseUrl')+'/mcp'));"
            ]
          }
        }
      ]
    },
    {
      "name": "PKCE server discovery",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/.well-known/oauth-authorization-server"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP200',()=>pm.response.to.have.status(200));",
              "pm.test('S256 required',()=>pm.expect(pm.response.json().code_challenge_methods_supported).to.deep.eql(['S256']));"
            ]
          }
        }
      ]
    },
    {
      "name": "Anonymous MCP denied",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/mcp",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"ping\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP401',()=>pm.response.to.have.status(401));",
              "pm.test('Bearer discovery',()=>pm.expect(pm.response.headers.get('WWW-Authenticate')).to.include('resource_metadata'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Private agent grants denied",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/agent/grants"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP401',()=>pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    }
  ]
}
