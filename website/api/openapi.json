{
  "openapi": "3.1.0",
  "info": {
    "title": "Oraclebot account and research API",
    "version": "0.1.0",
    "description": "Same-origin API hosted on Cloudflare Workers with D1. Every browser mutation requires Origin to match APP_ORIGIN; the Stripe webhook instead requires a valid HMAC over its exact raw bytes. Wallet sign-in authenticates an account and never grants transaction authority. Live execution is unavailable. No artificial local trial grants paid access."
  },
  "servers": [
    {
      "url": "https://oraclebot.io"
    }
  ],
