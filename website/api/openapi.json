  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-oraclebot",
        "description": "24-hour opaque random token; only SHA-256 token hash is stored. HttpOnly; Secure; SameSite=Lax; Path=/."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "error",
          "message"
        ],
        "additionalProperties": false
      },
      "BotConfiguration": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "coin": {
            "type": "string",
            "enum": [
              "SOL",
              "BTC",
              "ETH",
              "ZEC"
            ]
          },
          "strategy": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$",
            "maxLength": 100
          },
          "venue": {
            "enum": [
              "coinbase",
              "jupiter"
            ]
          },
          "leverage": {
            "type": "number",
            "minimum": 1,
            "maximum": 5,
            "default": 1
          },
          "budget": {
            "type": "number",
            "minimum": 1,
            "maximum": 1000000
          },
          "mode": {
            "const": "paper",
            "default": "paper"
          }
        },
        "required": [
          "name",
          "coin",
          "strategy",
          "venue",
          "budget"
        ],
        "additionalProperties": false
      }
    }
  }
