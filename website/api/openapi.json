          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "coin": {
                    "type": "string",
                    "enum": [
                      "SOL",
                      "BTC",
                      "ETH",
                      "ZEC"
                    ]
                  },
                  "strategy": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]+$",
                    "maxLength": 100
                  },
                  "venue": {
                    "enum": [
                      "coinbase",
                      "jupiter"
                    ]
                  },
                  "leverage": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 5,
                    "default": 1
                  },
                  "budget": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 1000000
                  },
                  "mode": {
                    "const": "paper",
                    "default": "paper"
                  }
                },
                "required": [
                  "name",
                  "coin",
                  "strategy",
                  "venue",
                  "budget"
                ],
                "additionalProperties": false
