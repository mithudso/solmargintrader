{
  "name": "oraclebot-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev --config wrangler.dev.jsonc --port 8799",
    "test": "node --test test/*.test.js",
    "check": "node --check src/worker.js && node --check public/app.js && node --check public/evidence.js",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply oraclebot-accounts --local",
    "db:remote": "wrangler d1 migrations apply oraclebot-accounts --remote"
  },
  "devDependencies": {
    "wrangler": "4.160.1"
  }
}
