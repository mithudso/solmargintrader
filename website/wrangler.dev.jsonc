{
  "name": "oraclebot",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-11",
  "workers_dev": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oraclebot-accounts",
      "database_id": "5526a15f-8063-4b5b-8a9d-b20babf0337d",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_ORIGIN": "http://localhost:8799",
    "RELEASE": "website-0.1.1",
    "APP_VERSION": "0.1.1"
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "0 3 * * *"
    ]
  }
}
