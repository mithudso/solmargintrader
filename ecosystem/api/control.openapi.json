  "components": {
    "securitySchemes": {
      "ControlNonce": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Sol-CSRF",
        "description": "In-memory CSRF nonce from /api/session; resets on controller restart. Loopback and Origin checks also apply."
      }
    },
    "schemas": {
      "MachineHealthEnvelope": {
        "type": "object",
        "required": [
          "schema_version",
          "ok",
          "data",
          "error"
        ],
        "properties": {
          "schema_version": {
            "const": 1
          },
          "ok": {
            "type": "boolean"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "data": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "schema_version",
                  "observed_at",
                  "overall",
                  "components",
                  "ready",
                  "ui_url",
                  "orders_available"
                ],
                "properties": {
                  "schema_version": {
                    "const": 1
                  },
                  "observed_at": {
                    "type": "number",
                    "description": "Unix epoch seconds; measurement time, not a trading clock."
                  },
                  "overall": {
                    "enum": [
                      "up",
                      "degraded",
                      "down",
                      "unknown"
                    ]
                  },
                  "ui_url": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Verified loopback UI origin when available."
                  },
                  "availability_ready": {
                    "type": "boolean"
                  },
                  "components": {
                    "type": "object",
                    "required": [
                      "suite",
                      "manager",
                      "control_room",
                      "market_data"
                    ],
                    "additionalProperties": {
                      "type": "object",
                      "required": [
                        "state",
                        "ready",
                        "reason"
                      ],
                      "properties": {
                        "state": {
                          "enum": [
                            "up",
                            "degraded",
                            "down",
                            "unknown"
                          ]
                        },
                        "ready": {
                          "type": [
                            "boolean",
                            "null"
                          ]
                        },
                        "reason": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      }
                    }
                  },
                  "ready": {
                    "type": "boolean",
                    "description": "Only suite, manager and control-room availability; excludes market certification and order permission."
                  },
                  "orders_available": {
                    "const": false
                  }
                }
              },
              {
                "type": "null",
                "description": "Measurement failed; ok=false and error carries a fixed public reason."
              }
            ]
          }
        }
      }
    }
  }
}
