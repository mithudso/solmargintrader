    "/api/oracle": {
      "get": {
        "summary": "Read-only Oracle display by coin, native candle frequency, and strategy",
        "parameters": [
          {
            "name": "run_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "instrument",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "interval",
            "in": "query",
            "required": false,
            "description": "Native candle interval, for example 1m or 1h. Omit for published/native default. Missing combinations return unavailable; no resampling.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "strategy",
            "in": "query",
            "required": false,
            "description": "Recorded canonical strategy ID or frozen study candidate ID; omit for published/saved aggregate. Display preview never saves voter settings or changes workers.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Native-cadence Oracle observation and display choices. Unsupported coin/frequency/strategy combinations explicitly return unavailable. Named study candidates use their own account forecasts. Single canonical strategy graphs contain only its recorded calls and exclude the archived full-catalog aggregate. Display selection never changes the published winner, saved voters, or paper accounts."
          },
          "400": {
            "description": "Invalid input or conflicting request"
          },
          "403": {
            "description": "Local origin or control session required"
          },
          "503": {
            "description": "Owner or durable evidence unavailable"
          }
        }
      }
    },
    "/api/actions": {
      "get": {
        "summary": "Observe durable action receipts",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Versioned JSON observation or existing action receipt"
          },
          "400": {
            "description": "Invalid input or conflicting request"
          },
          "403": {
            "description": "Local origin or control session required"
          },
          "503": {
            "description": "Owner or durable evidence unavailable"
          }
        }
      },
      "post": {
        "summary": "Queue a paper-only owner action exactly once per request UUID",
        "description": "Requires exact same-origin Origin plus X-Sol-CSRF nonce. A succeeded command receipt does not establish worker liveness. Interrupted actions are never replayed automatically. Unknown live/order/signing actions and credential-bearing payloads are refused. Runtime files are resolved from registered run IDs, never request paths.",
        "security": [
          {
            "ControlNonce": []
          }
        ],
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "action",
                  "request_id",
                  "params"
                ],
                "properties": {
                  "action": {
                    "type": "string",
                    "enum": [
                      "backtest.restart",
                      "backtest.start",
                      "backtest.stop",
                      "manager.apply",
                      "manager.create",
                      "manager.cycle-check",
                      "manager.data-check",
                      "manager.edit",
                      "manager.prepare-input",
                      "manager.register-input",
                      "manager.service",
                      "manager.start",
                      "manager.stop",
                      "oracle.restart",
                      "oracle.start",
                      "oracle.stop",
                      "oracle.voters.set",
                      "pipeline.restart",
                      "pipeline.start",
                      "pipeline.stop",
                      "pnl.recording.set",
                      "recorder.start",
                      "recorder.stop",
                      "research.launch"
                    ]
                  },
                  "request_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "params": {
                    "type": "object",
                    "description": "Owner-validated action parameters. run_id optionally targets a registered child. Research launches accept name, coin/strategy lists, interval/horizon presets, date bounds, independent paper capital, recording policy, swap provider and explicit configured costs. Recording/voter changes require expected_revision. Manager controls delegate their versioned owner schema."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Versioned JSON observation or existing action receipt"
          },
          "400": {
            "description": "Invalid input or conflicting request"
          },
          "403": {
            "description": "Local origin or control session required"
          },
          "503": {
            "description": "Owner or durable evidence unavailable"
          },
          "202": {
            "description": "Durably queued; poll /api/actions?id=<request_id>"
          }
        }
      }
    },
