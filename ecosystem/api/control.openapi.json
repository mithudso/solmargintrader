{
  "openapi": "3.1.0",
  "info": {
    "title": "Sol paper control room",
    "version": "0.3.0",
    "description": "Local paper controls and observability. No server order, wallet-key, signing or submission endpoints. Manual Jupiter swaps run on a distinct loopback origin and require browser-wallet approval."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:{port}",
      "variables": {
        "port": {
          "default": "8768",
          "description": "Use the actual bound port from control-server.json"
        }
      }
    }
  ],
