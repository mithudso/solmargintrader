#!/usr/bin/env bash
# Keep the committed index in step with the tree, and refuse a commit whose
# backtester suite is red.
#
# The index staleness check is a TEST (backtester/tests/test_index.py), so adding
# any file turns the suite red until index/ is rebuilt. Failing the commit and
# making the author read a traceback is the wrong trade when `index/build.py all`
# is idempotent and takes under a second: rebuild, stage it, say so.
#
# Skip with `git commit --no-verify` when you genuinely mean to (a WIP commit you
# will amend). Nothing here touches a remote.

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# Validate exactly what will be committed. Preserve partial staging by refusing
# before generation when the working tree has additional, unreviewed content.
# Only bother when something is actually staged.
git diff --cached --quiet && exit 0
if ! git diff --quiet || [ -n "$(git ls-files --others --exclude-standard)" ]; then
  echo "pre-commit: stage or isolate the intended changes before validating the staged tree" >&2
  exit 1
fi

if [ -f index/build.py ]; then
  if python3 index/build.py all >/dev/null 2>&1; then
    if ! git diff --quiet -- index/INDEX.json index/TEXT-INDEX.json index/CONCEPT-INDEX.json; then
      git add -- index/INDEX.json index/TEXT-INDEX.json index/CONCEPT-INDEX.json || {
        echo "pre-commit: generated index staging failed — commit refused" >&2
        exit 1
      }
      echo "pre-commit: index rebuilt and staged"
    fi
  else
    echo "pre-commit: index/build.py failed — commit refused" >&2
    exit 1
  fi
fi

if ! out=$(python3 -m unittest discover -s backtester/tests -t . 2>&1); then
  echo "pre-commit: backtester suite is red — commit refused" >&2
  printf '%s\n' "$out" | tail -20 >&2
  echo "pre-commit: use --no-verify only if you mean to commit a known-red tree" >&2
  exit 1
fi

exit 0
