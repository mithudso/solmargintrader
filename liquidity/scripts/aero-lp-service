#!/bin/zsh
# Run the liquidity daemon as a per-user launchd agent.
#   aero-lp-service install [--live]      write the plist and start it (dry-run unless --live)
#   aero-lp-service uninstall             stop it and remove the plist
#   aero-lp-service status | logs         launchctl state / tail the log
#   aero-lp-service kill | resume         pause on-chain actions (KILL file) / resume them
#   aero-lp-service exit-to-safe [--live] withdraw EVERY position to the wallet (dry run unless --live)
set -euo pipefail

LABEL="com.mithudso.aero-lp"
HERE="${0:A:h}"
LIQ="${HERE:h}"
BIN="$LIQ/.venv/bin/aero-lp"
LP_HOME="${AERO_LP_HOME:-$HOME/.aero-lp}"
CONFIG="$LP_HOME/config.toml"
PLIST="${AERO_LP_LAUNCHAGENTS_DIR:-$HOME/Library/LaunchAgents}/$LABEL.plist"
DOMAIN="gui/$(id -u)"

case "${1:-}" in
  install)
    [[ $# -le 2 && ( -z "${2:-}" || "${2:-}" == "--dry-run" || "${2:-}" == "--live" ) ]] || {
      echo "usage: $0 install [--dry-run|--live]" >&2; exit 2;
    }
    [[ -x "$BIN" ]] || { echo "missing $BIN — run: cd $LIQ && uv sync --extra dev -p 3.13"; exit 1; }
    [[ -f "$CONFIG" ]] || { echo "missing $CONFIG — copy $LIQ/config.example.toml there and edit it"; exit 1; }
    mode_args=""
    mode_label="dry-run"
    if [[ "${2:-}" == "--live" ]]; then
      mode_args="<string>--live</string>"
      mode_label="live"
    fi
    mkdir -p "$LP_HOME" "${PLIST:h}"
    temporary="$(mktemp "${PLIST}.XXXXXX")"
    trap 'rm -f "$temporary"' EXIT
    "$LIQ/.venv/bin/python" -m aero_lp.service "$BIN" "$LP_HOME" "$LABEL" "$mode" > "$temporary"
    mv "$temporary" "$PLIST"
    launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null || true
    launchctl bootstrap "$DOMAIN" "$PLIST"
    echo "started $LABEL ($mode_label); log: $LP_HOME/daemon.log"
    ;;
  uninstall)
    launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null || true
    rm -f "$PLIST"
    echo "stopped and removed $LABEL"
    ;;
  status) launchctl print "$DOMAIN/$LABEL" 2>/dev/null | grep -E "state =|pid =|last exit" || echo "not loaded" ;;
  logs) tail -n "${2:-50}" "$LP_HOME/daemon.log" ;;
  kill) touch "$LP_HOME/KILL" && echo "KILL set: the daemon takes no on-chain action until resume" ;;
  resume) rm -f "$LP_HOME/KILL" && echo "KILL cleared" ;;
  exit-to-safe) shift; exec "$BIN" exit-to-safe -c "$CONFIG" "$@" ;;
  *) sed -n '2,8p' "$0"; exit 2 ;;
esac
