# Names only: export values in your shell. Programs do not automatically load .env.
# Jupiter reachability probe key. The installed extension uses chrome.storage.local.
JUPITER_API_KEY=
# Local extension HTTP port and bearer token.
SMT_API_PORT=8787
SMT_API_TOKEN=
# Local HTTP session-key vault passphrase.
SMT_PASSPHRASE=
# Optional research cache directory override.
# SOLMT_DATA_DIR=/absolute/path/to/data
# Optional liquidity state directory and owner-only mode-0600 key file path.
# AERO_LP_HOME=/absolute/path/to/state
# AERO_LP_KEY_FILE=/absolute/path/to/owner-only-key
# Legacy private-key environment fallback; prefer key file or Keychain. Never commit a value.
AERO_LP_PRIVATE_KEY=
# Optional interpreter for the soltui shell launcher.
# SOLTUI_PYTHON=/absolute/path/to/python
# SOLTUI_BG_LOCK_FD is internal worker state; do not set it manually.

# 19. Managed availability and collector roots (optional; defaults are private user homes).
# SOLBOT_HOME=/absolute/private/manager-home
# SOLBOT_ECOSYSTEM_HOME=/absolute/private/ecosystem-home
# Disable automatic semantic indexing for lookup, testing and unattended helpers.
# INDEX_NO_AUTO=1

# 20. Native helper installer overrides (optional; install locally, never from browser input).
# SOLTUI_APP_SUPPORT_ROOT=/absolute/browser-support-root
# SOLTUI_SUPPORT_DIR=/absolute/private/soltui-support
# Comma-separated reviewed extension IDs; do not permit arbitrary origins.
# SOLTUI_EXTRA_EXTENSION_IDS=
# Local reviewed unpacked extension assets for the helper's build identity.
# SOLTUI_EXTENSION_DIR=/absolute/reviewed/extension

# Optional TradingView body secret. Prefer --secret-file with a private local file.
# Keep the value out of service arguments, logs, committed configs and browser DOM.
# ORACLE_WEBHOOK_SECRET=

# Hosted website bindings. This repository does not auto-load this file.
# Wrangler vars/bindings or an ignored website/.dev.vars configure the Worker.
# Set secrets through the provider's secret mechanism; never commit real values.
APP_ORIGIN=https://oraclebot.io
APP_VERSION=0.1.1
PRICE_LABEL=
STRIPE_PRICE_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ENGINE_URL=
ENGINE_TOKEN=

# Read-only Python analysis adapter. Supply dedicated public analysis inputs.
# It does not start a feed, trading worker or owner control-room service.
ENGINE_DATA_DIR=
ENGINE_ORACLE_DIR=
ENGINE_ORACLE_QUOTE=USD
