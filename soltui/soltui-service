#!/usr/bin/env python3
"""Install / start / stop the soltui menu-bar LaunchAgent.

    soltui/soltui-service build      # py2app alias build into dist/
    soltui/soltui-service install    # copy bundle to ~/Applications + write the agent
    soltui/soltui-service start      # create the supervise flag -> launchd starts it
    soltui/soltui-service stop       # remove the flag -> launchd stops supervising
    soltui/soltui-service status
    soltui/soltui-service uninstall

Edit THIS script, not the generated plist -- `install` overwrites the plist.

## Design decisions inherited from net-dns-monitor, not rediscovered

Its plist documents four hard-won lessons; all four are reproduced here because
the failure modes are identical for any rumps status-item app.

1. **A LaunchAgent, not a LaunchDaemon.** rumps needs the logged-in user's GUI
   session. A daemon runs before login with no window server access and could
   never draw a status item.

2. **ProgramArguments points at the executable inside the .app bundle**, not at
   `python3 -m soltui.app`. Framework Python re-execs into its own bundled
   Python.app the instant rumps creates the GUI, so a bare module launch shows
   "Python" in the Dock, Cmd-Tab and Force Quit.

3. **The bundle path must be ~/Applications, never a build or worktree
   directory.** Anything under `.claude/worktrees/` can be deleted at any time,
   and when it is, login startup breaks silently. `install` refuses to write an
   agent pointing inside a worktree.

4. **No RunAtLoad.** It starts the app whenever the agent is loaded -- including
   every login -- regardless of the flag file, so `stop` would silently undo
   itself at the next login. `KeepAlive` with a `PathState` condition is enough
   to start the job at load when the flag exists, and it does so for the right
   reason: because supervision is enabled. The flag file is therefore the real
   on/off switch, which is necessary because KeepAlive overrides the menu bar's
   own Quit item.

Plus: `LANG` is set explicitly. launchd starts processes with no LANG at all,
making the locale encoding US-ASCII; the status glyphs in status.py are
non-ASCII, and net-dns-monitor hit precisely this as 0-byte report files.
"""

from __future__ import annotations

import argparse
import os
import plistlib
import shlex
import shutil
import subprocess
import sys
import sysconfig
import tempfile
import time
from pathlib import Path

try:
    from launchd_supervisor import ServiceSpec, atomic_write, render_plist
    from launchd_supervisor import manage as launchd_manage
    from launchd_supervisor.plist import plist_dict
    HAVE_SUPERVISOR = True
except ImportError:
    HAVE_SUPERVISOR = False
    ServiceSpec = atomic_write = render_plist = launchd_manage = plist_dict = None

LABEL = "com.mitchhudson.soltui"
APP_NAME = "SolTUI"
REPO = Path(__file__).resolve().parent.parent
HOME = Path.home()

APPS_DIR = HOME / "Applications"
BUNDLE = APPS_DIR / f"{APP_NAME}.app"
BUNDLE_EXE = BUNDLE / "Contents" / "MacOS" / APP_NAME
DIST_BUNDLE = REPO / "dist" / f"{APP_NAME}.app"
AGENT = HOME / "Library" / "LaunchAgents" / f"{LABEL}.plist"
SUPPORT = HOME / "Library" / "Application Support" / "soltui"
FLAG = SUPPORT / "supervise.enabled"
LOG = HOME / "Library" / "Logs" / "soltui.launchd.log"
SUBPROCESS_TIMEOUT_S = 30
UNLOAD_TIMEOUT_S = 5


def _require_supervisor() -> None:
    if HAVE_SUPERVISOR:
        return
    environment = Path.home() / ".venvs" / "soltui-app"
    python = environment / "bin" / "python"
    def quote(value: Path) -> str:
        return shlex.quote(str(value))
    raise ImportError(
        "soltui-service needs macos-launchd-supervisor in its isolated environment:\n"
        f"    uv venv {quote(environment)} --python /opt/homebrew/opt/python@3.13/bin/python3.13\n"
        f"    uv pip install --python {quote(python)} -r {quote(REPO / 'backtester/requirements.txt')} "
        f"-r {quote(REPO / 'soltui/requirements.txt')}"
    )


def uid() -> int:
    """Current user id, for the launchd gui/ domain."""
    return os.getuid()


def run(cmd: list[str], check: bool = False) -> subprocess.CompletedProcess:
    """Run a command, echoing it so the effect is auditable."""
    print("  $", " ".join(cmd))
    return subprocess.run(cmd, check=check, capture_output=True, text=True, timeout=SUBPROCESS_TIMEOUT_S)


# py2app's launcher loads libpython from the paths in Info.plist PyRuntimeLocations, which it
# copies from the build interpreter's framework. Two ways this broke the app with "A Python
# runtime not could be located" (2026-11-07):
#   - building from a non-framework interpreter (uv's standalone CPython, which ~/.venvs/soltui
#     uses), which has no framework for the launcher to load;
#   - the build framework being removed later (the python.org 3.13 install at
#     /Library/Frameworks went away), so every recorded path dangled.
# Build from a venv on Homebrew's python@3.13: it is a framework build, and its framework is
# recorded through the stable /opt/homebrew/opt symlink, so patch upgrades do not break it.
FRAMEWORK_VENV_HINT = (
    "uv venv ~/.venvs/soltui-app -p /opt/homebrew/opt/python@3.13/bin/python3.13\n"
    "    uv pip install -p ~/.venvs/soltui-app/bin/python -r backtester/requirements.txt -r soltui/requirements.txt\n"
    "    ~/.venvs/soltui-app/bin/python soltui/soltui-service build"
)


def framework_problem() -> str | None:
    """Why this interpreter cannot host a py2app bundle, or None when it can."""
    if sysconfig.get_config_var("PYTHONFRAMEWORK"):
        return None
    return (f"{sys.executable} is not a framework build of Python, so py2app cannot make a bundle "
            f"that launches. Build from a framework venv:\n    {FRAMEWORK_VENV_HINT}")


def runtime_problem(bundle: Path) -> str | None:
    """None when the bundle's PyRuntimeLocations names a Python that exists, else why not."""
    info = bundle / "Contents" / "Info.plist"
    try:
        with info.open("rb") as fh:
            locations = plistlib.load(fh).get("PyRuntimeLocations") or []
    except (OSError, plistlib.InvalidFileException) as exc:
        return f"cannot read PyRuntimeLocations from {info}: {exc}"
    exe_dir = bundle / "Contents" / "MacOS"
    for loc in locations:
        if Path(str(loc).replace("@executable_path", str(exe_dir))).exists():
            return None
    return (f"no Python runtime in {info} exists ({', '.join(map(str, locations)) or 'none listed'}); "
            f"the app will fail with 'A Python runtime not could be located'. Rebuild:\n    {FRAMEWORK_VENV_HINT}")


def build() -> int:
    """py2app alias build into dist/."""
    problem = framework_problem()
    if problem:
        print(problem, file=sys.stderr)
        return 1
    print(f"Building {APP_NAME}.app (alias mode) …")
    proc = subprocess.run(
        [sys.executable, str(REPO / "soltui" / "setup_app.py"), "py2app", "-A"],
        cwd=REPO,
    )
    if proc.returncode != 0:
        print("build failed", file=sys.stderr)
        return proc.returncode
    if not DIST_BUNDLE.exists():
        print(f"expected {DIST_BUNDLE} but it is absent", file=sys.stderr)
        return 1
    problem = runtime_problem(DIST_BUNDLE)
    if problem:
        print(problem, file=sys.stderr)
        return 1
    print(f"built → {DIST_BUNDLE}")
    return 0


def service_spec() -> ServiceSpec:
    """The declarative spec macos-launchd-supervisor renders the agent from.

    Every choice in the module docstring is carried by it: the program is the
    executable inside the bundle (lesson 2, passed as the executable path rather
    than the .app so ProgramArguments does not depend on Info.plist); `supervise`
    gives KeepAlive+PathState on FLAG and never RunAtLoad (lesson 4); the library's
    default `lang` is the explicit LANG. tests/test_service_plist_parity.py pins
    the rendered plist to the one this script generated before the migration.
    """
    _require_supervisor()
    return ServiceSpec(
        label=LABEL,
        program=str(BUNDLE_EXE),
        env={"PYTHONUTF8": "1"},
        supervise=True,
        state_dir=str(SUPPORT),
        throttle_interval=15,
        process_type="Interactive",
        stdout_path=str(LOG),
        stderr_path=str(LOG),
    )


def agent_plist() -> dict:
    """The LaunchAgent definition. See the module docstring for every choice."""
    _require_supervisor()
    return plist_dict(service_spec())


def install() -> int:
    """Copy the bundle to ~/Applications and write + bootstrap the agent."""
    if not DIST_BUNDLE.exists():
        print(f"no bundle at {DIST_BUNDLE}. Run: soltui/soltui-service build",
              file=sys.stderr)
        return 1

    # An alias bundle still references its source. A linked worktree is
    # transient regardless of its directory name, so refuse before replacement.
    if (REPO / ".git").is_file():
        print(f"refusing alias install from git worktree {REPO}; build and install from the main checkout", file=sys.stderr)
        return 1

    # Lesson 3: never install from, or point at, a worktree path.
    if ".claude/worktrees" in str(BUNDLE):
        print(
            "refusing to install: the target path is inside a git worktree, which "
            "can be deleted and would break login startup silently.",
            file=sys.stderr,
        )
        return 1
    if ".claude/worktrees" in str(REPO):
        print(
            f"WARNING: building from a worktree ({REPO}).\n"
            "  An alias bundle references its source tree, so this bundle will "
            "break when the worktree is removed.\n"
            "  Merge to master and rebuild from /Users/mitch.hudson/dev/"
            "solmargintrader before relying on login startup.",
            file=sys.stderr,
        )

    APPS_DIR.mkdir(parents=True, exist_ok=True)
    staging = Path(tempfile.mkdtemp(prefix=".soltui-install-", dir=APPS_DIR))
    candidate, previous = staging / "candidate.app", staging / "previous.app"
    activated = False
    complete = False
    agent_written = False
    recovery_required = False
    old_agent = None
    had_agent = AGENT.exists()
    try:
        old_agent = AGENT.read_bytes() if had_agent else None
        if had_agent:
            saved_agent = staging / "previous-agent.plist"
            saved_agent.write_bytes(old_agent)
            saved_agent.chmod(0o600)
        shutil.copytree(DIST_BUNDLE, candidate, symlinks=True)
        dereference_resources(candidate)
        executable = candidate / "Contents" / "MacOS" / APP_NAME
        problem = runtime_problem(candidate)
        if not executable.is_file() or not os.access(executable, os.X_OK) or problem:
            raise ValueError(problem or "staged bundle executable is unavailable")
        SUPPORT.mkdir(parents=True, exist_ok=True)
        LOG.parent.mkdir(parents=True, exist_ok=True)
        AGENT.parent.mkdir(parents=True, exist_ok=True)
        if BUNDLE.exists():
            BUNDLE.rename(previous)
        candidate.rename(BUNDLE)
        activated = True
        # Keep the previous app and plist until activation is confirmed.
        agent_written = True
        atomic_write(AGENT, render_plist(service_spec()))
        if not reload_agent():
            raise RuntimeError("replacement agent could not be loaded")
        complete = True
        print(f"installed and loaded → {BUNDLE}")
        print("The app is supervised only while its supervision flag exists.")
        return 0
    except BaseException as exc:
        try:
            if activated and BUNDLE.exists():
                shutil.rmtree(BUNDLE)
            if previous.exists():
                previous.rename(BUNDLE)
            if agent_written:
                if had_agent:
                    atomic_write(AGENT, old_agent)
                else:
                    AGENT.unlink(missing_ok=True)
        except OSError:
            recovery_required = True
            print(f"installation failed; retained recovery files at {staging}", file=sys.stderr)
            return 1
        if not isinstance(exc, (OSError, ValueError, RuntimeError)):
            raise
        print(f"installation failed; previous installation preserved: {exc}", file=sys.stderr)
        return 1
    finally:
        # A failed rollback must retain its backup for explicit recovery.
        if not recovery_required and (complete or not previous.exists()):
            shutil.rmtree(staging, ignore_errors=True)


def dereference_resources(bundle: Path) -> list[Path]:
    """Replace symlinked bundle resources with real copies. Returns what changed.

    An alias build symlinks Contents/Resources back into the source tree, so the
    icon would break the moment the repo moves -- and a bundle whose icon is a
    dangling link falls back to the generic executable icon with no error
    anywhere. Copying the small, self-contained resources in means the icon at
    least survives a move even though the alias-mode *code* still will not.

    Only files are dereferenced, and only in Resources: the Frameworks and lib
    symlinks are what make alias mode work at all.
    """
    changed: list[Path] = []
    resources = bundle / "Contents" / "Resources"
    if not resources.is_dir():
        return changed
    for entry in resources.iterdir():
        if not entry.is_symlink() or not entry.is_file():
            continue
        target = entry.resolve()
        if not target.exists():
            print(f"  WARNING: dangling resource symlink {entry.name}", file=sys.stderr)
            continue
        entry.unlink()
        shutil.copy2(target, entry)
        changed.append(entry)
    if changed:
        print(f"  copied in {len(changed)} resource(s): "
              f"{', '.join(p.name for p in changed)}")
    return changed


def is_loaded() -> bool:
    """Whether launchd currently knows about the agent."""
    _require_supervisor()
    return launchd_manage.is_loaded(service_spec())


def reload_agent() -> bool:
    """Bootout then bootstrap, waiting for each step to actually take effect.

    `launchctl bootout` is ASYNCHRONOUS: it returns before the job is gone, so a
    bootstrap issued immediately afterwards races it and fails with a confusing
    "Try re-running the command as root" -- leaving the agent UNLOADED while
    install reported success. Found empirically after a reinstall silently
    stopped starting the app at login.

    So: poll until the old job has really gone, then bootstrap, then poll until
    the new one is really there. Returns True only if the agent ends up loaded.
    """
    _require_supervisor()
    if not launchd_manage.reload_agent(service_spec()):
        return False
    print("  agent loaded")
    return True


def start() -> int:
    """Create the flag file; launchd starts and supervises the app.

    Loads the agent first when launchd does not already know about it. A plist
    can sit on disk unloaded -- a bootstrap that lost the race described in
    `reload_agent`, or a machine where `install` was never run to completion --
    and in that state `kickstart` targets a job that does not exist and fails.
    Its return code was ignored, so `start` printed "started" while nothing ran:
    no menu-bar item, no console window, and an *empty* launchd log, because a
    job that never started writes nothing to explain itself. That combination is
    close to undiagnosable from the outside, which is why both this and the
    kickstart result are now checked. `status` reports the same state as
    `launchd : not loaded`.
    """
    if not AGENT.exists():
        print(f"no agent at {AGENT}. Run: soltui/soltui-service install",
              file=sys.stderr)
        return 1

    SUPPORT.mkdir(parents=True, exist_ok=True)
    FLAG.touch()
    print(f"flag created → {FLAG}")

    # Only when it is absent: booting out a healthy job would stop a running app
    # for no reason, and KeepAlive would then restart it on the throttle delay.
    if not is_loaded():
        print("  agent was not loaded; loading it")
        if not reload_agent():
            print(
                "\nThe agent could not be loaded, so nothing will start:\n"
                f"    launchctl bootstrap gui/{uid()} {AGENT}",
                file=sys.stderr,
            )
            return 1

    res = run(["launchctl", "kickstart", f"gui/{uid()}/{LABEL}"])
    if res.returncode != 0:
        detail = (res.stderr or res.stdout).strip()
        print(f"kickstart failed: {detail or 'no output'}", file=sys.stderr)
        return 1

    print("started (and will start at login while the flag exists)")
    return 0


def stop() -> int:
    """Remove the flag file; launchd stops supervising and shuts the app down."""
    if FLAG.exists():
        FLAG.unlink()
        print(f"flag removed → {FLAG}")
    else:
        print("flag was already absent")
    result = run(["launchctl", "kill", "SIGTERM", f"gui/{uid()}/{LABEL}"])
    if result.returncode:
        detail = (result.stderr or result.stdout).strip()
        absent = "no such process" in detail.casefold() or "could not find service" in detail.casefold()
        if not absent or is_loaded():
            print(f"stop was not confirmed: {detail or 'launchctl failed'}; supervision is disabled but the job needs inspection", file=sys.stderr)
            return 1
    print("stopped (will not start at login)")
    return 0


def status() -> int:
    """Report every piece of state, so a partial install is visible."""
    print(f"bundle      : {BUNDLE} {'✓' if BUNDLE.exists() else '✗ (not installed)'}")
    print(f"agent plist : {AGENT} {'✓' if AGENT.exists() else '✗'}")
    print(f"supervise   : {FLAG} {'✓ enabled' if FLAG.exists() else '✗ disabled'}")
    print(f"log         : {LOG} {'✓' if LOG.exists() else '(no output yet)'}")
    for bundle in (BUNDLE, DIST_BUNDLE):
        if bundle.exists():
            problem = runtime_problem(bundle)
            print(f"runtime     : {bundle.name} in {bundle.parent} {'✓' if not problem else '✗ ' + problem}")
    res = run(["launchctl", "print", f"gui/{uid()}/{LABEL}"])
    if res.returncode != 0:
        print("launchd     : not loaded")
    else:
        for line in res.stdout.splitlines():
            if any(k in line for k in ("state =", "pid =", "last exit")):
                print(f"launchd     : {line.strip()}")
    return 0


def uninstall() -> int:
    """Remove the agent, the flag and the installed bundle."""
    if stop() != 0:
        return 1
    result = run(["launchctl", "bootout", f"gui/{uid()}/{LABEL}"])
    if result.returncode and is_loaded():
        print("uninstall refused: bootout failed; agent and bundle retained", file=sys.stderr)
        return 1
    deadline = time.monotonic() + UNLOAD_TIMEOUT_S
    while is_loaded():
        if time.monotonic() >= deadline:
            print("uninstall refused: job is still loaded; agent and bundle retained", file=sys.stderr)
            return 1
        time.sleep(0.1)
    for path in (AGENT, BUNDLE):
        if path.exists():
            shutil.rmtree(path) if path.is_dir() else path.unlink()
            print(f"removed {path}")
    print("uninstalled")
    return 0


COMMANDS = {
    "build": build, "install": install, "start": start,
    "stop": stop, "status": status, "uninstall": uninstall,
}


def main(argv: list[str] | None = None) -> int:
    """Dispatch a subcommand."""
    ap = argparse.ArgumentParser(
        description="Manage the soltui menu-bar LaunchAgent.",
        epilog="Typical first run: build → install → start",
    )
    ap.add_argument("command", choices=sorted(COMMANDS))
    args = ap.parse_args(argv)
    if sys.platform != "darwin":
        print("macOS only.", file=sys.stderr)
        return 1
    try:
        if args.command != "build":
            _require_supervisor()
        return COMMANDS[args.command]()
    except ImportError as exc:
        print(str(exc), file=sys.stderr)
        return 3
    except (OSError, subprocess.SubprocessError) as exc:
        print(f"service operation could not complete ({type(exc).__name__}); inspect status before retrying", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
