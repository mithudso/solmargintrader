# Local state — holds the Jupiter API key and the encrypted session-key vault.
# Must never be committed.
.solmargintrader/
*.local.json
journal.json
config.json

# Secrets
.env
.env.*
!.env.example

# The jup.ag reference dump: ~42 MB of rendered HTML plus its zip. Useful
# locally as reference material, wrong to put in git history.
jup.ag/
jup.ag.zip

# Node
node_modules/
npm-debug.log*
.npm/

# Build/coverage output (there is no build step today; kept for safety)
dist/
build/
coverage/
*.tsbuildinfo

# Editor / OS
.DS_Store
.idea/
*.swp
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Packaged extension
*.crx
*.pem
*.zip
!extension/**/*.zip

# Temp
*.tmp
*.tmp.*

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Regenerable data caches. Refetch with:
#   python3 -m backtester.core.fetch --asset SOL --interval 1d --start 2021-01-01
#   python3 -m backtester.core.fetch --asset SOL --interval 1h --start 2025-08-01 --allow-gaps
data/

# Regenerable CLI output. Rebuild with:
#   python3 -m backtester.cli --asset SOL --strategy all --out results/
# NOTE the leading slash: this must match ONLY the repo-root results/ directory.
# An unanchored "results/" also matches research/results/ at any depth, which is
# how the tracked-evidence fix below was silently defeated the first time.
/results/

# research/results/ is deliberately TRACKED, not ignored. Those CSVs are the
# evidence for every figure in research/*.md, and verify_numbers.py checks the
# documents against them. Ignoring them meant a fresh checkout could not verify
# its own claims -- and worse, a stale copy produced hundreds of spurious
# mismatches. They are small (~200KB total).

# Claude Code local state. worktrees/ holds live git worktrees (multi-MB, and
# committing a worktree from inside the repo it belongs to is recursive); the
# .local.json settings are per-machine by convention. A tracked
# .claude/settings.json would still be picked up if you add one.
.claude/worktrees/
.claude/settings.local.json

# Session scratch
.remember/logs/
.remember/tmp/
